# Copy this file to .env and fill in real values. Never commit the real
# .env file — it's already in .gitignore.
#
# Nothing in this file is required for local development: every setting
# in settings.py has a safe default that reproduces the current
# (pre-Sprint-6) behavior if the corresponding variable is unset.

# --- Core Django ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=

# --- Database (leave DB_ENGINE=mysql until the Postgres migration is done) ---
DB_ENGINE=mysql
DB_NAME=perfume_platform
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Email (SendGrid via django-anymail) ---
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@perfumeplatform.example

# --- Cache (Redis) ---
REDIS_URL=
CATALOG_CACHE_SECONDS=60

# --- Error monitoring (Sentry) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Production hardening (only read when DEBUG=False) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=2592000
CORS_ALLOWED_ORIGINS=

# --- Logging ---
DJANGO_LOG_LEVEL=INFO
