/* ══════════════════════════════════════════════════════════════
   ADMIN DASHBOARD LOGIC
   ══════════════════════════════════════════════════════════════ */

const API_BASE = 'http://127.0.0.1:8000/api';
let toastTimer;

function showToast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 2800);
}

/* ══════════════════════════════════════════════════════════════
   ACCESS GATE
   Real enforcement happens server-side (IsAdminRole on every admin
   endpoint) — this is just a friendly client-side redirect so a
   non-admin doesn't sit staring at an empty dashboard.
   ══════════════════════════════════════════════════════════════ */
const token = localStorage.getItem('access_token');
const roleId = localStorage.getItem('role_id');
const isAdmin = token && String(roleId) === '1';

if (!isAdmin) {
  document.getElementById('adminGate').style.display = 'block';
  document.getElementById('adminLayout').style.display = 'none';
} else {
  document.getElementById('adminGate').style.display = 'none';
  document.getElementById('adminLayout').style.display = 'block';
  initAdminDashboard();
}

document.getElementById('adminLogoutBtn').addEventListener('click', () => {
  localStorage.removeItem('access_token');
  localStorage.removeItem('token');
  localStorage.removeItem('role_id');
  localStorage.removeItem('user');
  window.location.href = '/';
});

/* Shared authenticated-fetch helper: attaches the JWT, and if the
   server itself says "not an admin" (e.g. token expired, or someone
   edited role_id in localStorage by hand), fall back to the gate —
   this is the real security check, the localStorage one above is
   just for a smoother first impression. */
async function adminFetch(url, options = {}) {
  const res = await fetch(url, {
    ...options,
    headers: {
      ...(options.headers || {}),
      'Authorization': `Bearer ${token}`,
    },
  });
  if (res.status === 401 || res.status === 403) {
    showToast('Your session isn\'t authorized for admin access.');
    document.getElementById('adminGate').style.display = 'block';
    document.getElementById('adminLayout').style.display = 'none';
    throw new Error('Not authorized');
  }
  return res;
}

/* ══════════════════════════════════════════════════════════════
   STATE
   ══════════════════════════════════════════════════════════════ */
let allProducts = [];
let brandsCache = [];
let editingPerfumeId = null;
let selectedImageFile = null;
let pendingDeleteProductId = null;

function initAdminDashboard() {
  loadBrandsIntoForm();
  loadProducts();

  document.getElementById('adminSearchInput').addEventListener('input', debounce(loadProducts, 350));
  document.getElementById('openAddModalBtn').addEventListener('click', () => openPerfumeModal());
  document.getElementById('perfumeModalCloseBtn').addEventListener('click', closePerfumeModal);
  document.getElementById('perfumeFormCancelBtn').addEventListener('click', closePerfumeModal);
  document.getElementById('perfumeForm').addEventListener('submit', submitPerfumeForm);

  document.getElementById('imageUploadZone').addEventListener('click', () => {
    document.getElementById('imageFileInput').click();
  });
  document.getElementById('imageFileInput').addEventListener('change', handleImageSelect);

  document.getElementById('deleteConfirmCloseBtn').addEventListener('click', closeDeleteConfirm);
  document.getElementById('deleteConfirmCancelBtn').addEventListener('click', closeDeleteConfirm);
  document.getElementById('deleteConfirmActionBtn').addEventListener('click', confirmDelete);
}

function debounce(fn, ms) {
  let t;
  return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
}

/* ══════════════════════════════════════════════════════════════
   LOAD BRANDS (for the dropdown in the add/edit form)
   ══════════════════════════════════════════════════════════════ */
async function loadBrandsIntoForm() {
  try {
    const res = await fetch(`${API_BASE}/catalog/brands/`);
    const data = await res.json();
    brandsCache = data.results || data;
    const select = document.getElementById('fBrand');
    select.innerHTML = '<option value="">Select a brand…</option>' +
      brandsCache.map(b => `<option value="${b.brand_id}">${b.brand_name}</option>`).join('');
  } catch {
    showToast('Could not load brands — check your connection.');
  }
}

/* ══════════════════════════════════════════════════════════════
   LOAD + RENDER PRODUCTS
   ══════════════════════════════════════════════════════════════ */
async function loadProducts() {
  const search = document.getElementById('adminSearchInput').value.trim();
  document.getElementById('adminTableBody').innerHTML = '<tr><td colspan="6" class="admin-loading">Loading products…</td></tr>';
  document.getElementById('adminCardList').innerHTML = '';

  try {
    const params = new URLSearchParams();
    if (search) params.set('search', search);
    const res = await adminFetch(`${API_BASE}/catalog/admin/products/?${params.toString()}`);
    const data = await res.json();
    allProducts = data.results || [];
    document.getElementById('adminCount').textContent = `${data.count || 0} products`;
    renderTable(allProducts);
    renderCards(allProducts);
  } catch {
    document.getElementById('adminTableBody').innerHTML = '<tr><td colspan="6" class="admin-empty">Couldn\'t load products.</td></tr>';
  }
}

function stockBadge(stock) {
  if (stock <= 0) return `<span class="stock-badge out-of-stock">Out of stock</span>`;
  if (stock <= 5) return `<span class="stock-badge low-stock">${stock} left</span>`;
  return `<span class="stock-badge in-stock">${stock} in stock</span>`;
}

const ADMIN_FALLBACK_IMG = 'https://images.unsplash.com/photo-1541643600914-78b084683702?w=100&q=80&auto=format';

function renderTable(products) {
  const tbody = document.getElementById('adminTableBody');
  if (!products.length) {
    tbody.innerHTML = '<tr><td colspan="6" class="admin-empty">No products found.</td></tr>';
    return;
  }
  tbody.innerHTML = products.map(p => `
    <tr>
      <td>
        <div style="display:flex;align-items:center;gap:12px;">
          <img class="admin-row-thumb" src="${p.image_url || ADMIN_FALLBACK_IMG}" onerror="this.src='${ADMIN_FALLBACK_IMG}'" alt=""/>
          <div>
            <div class="admin-row-name">${p.perfume_name}</div>
          </div>
        </div>
      </td>
      <td><span class="admin-row-brand">${p.brand_name || ''}</span></td>
      <td>${p.concentration || ''} · ${p.product_type === 'decant' ? 'Decant' : 'Full Bottle'} · ${Number(p.volume_ml)}ml</td>
      <td>৳${Number(p.price).toLocaleString()}</td>
      <td>${stockBadge(p.stock_quantity)}</td>
      <td>
        <div class="admin-row-actions">
          <button class="admin-icon-btn" title="Edit" onclick="openPerfumeModal(${p.perfume_id}, ${p.product_id})">✎</button>
          <button class="admin-icon-btn delete-btn" title="Delete" onclick="openDeleteConfirm(${p.product_id}, '${(p.perfume_name || '').replace(/'/g, "\\'")}')">🗑</button>
        </div>
      </td>
    </tr>
  `).join('');
}

function renderCards(products) {
  const list = document.getElementById('adminCardList');
  if (!products.length) {
    list.innerHTML = '<div class="admin-empty">No products found.</div>';
    return;
  }
  list.innerHTML = products.map(p => `
    <div class="admin-product-card">
      <img src="${p.image_url || ADMIN_FALLBACK_IMG}" onerror="this.src='${ADMIN_FALLBACK_IMG}'" alt=""/>
      <div class="admin-product-card-body">
        <div class="admin-product-card-top">
          <div>
            <div class="admin-row-name">${p.perfume_name}</div>
            <div class="admin-row-brand">${p.brand_name || ''}</div>
          </div>
          <div>৳${Number(p.price).toLocaleString()}</div>
        </div>
        <div class="admin-product-card-meta">${p.concentration || ''} · ${p.product_type === 'decant' ? 'Decant' : 'Full Bottle'} · ${Number(p.volume_ml)}ml</div>
        ${stockBadge(p.stock_quantity)}
        <div class="admin-product-card-actions">
          <button class="admin-icon-btn" title="Edit" onclick="openPerfumeModal(${p.perfume_id}, ${p.product_id})">✎ Edit</button>
          <button class="admin-icon-btn delete-btn" title="Delete" onclick="openDeleteConfirm(${p.product_id}, '${(p.perfume_name || '').replace(/'/g, "\\'")}')">🗑 Delete</button>
        </div>
      </div>
    </div>
  `).join('');
}

/* ══════════════════════════════════════════════════════════════
   ADD / EDIT MODAL
   ══════════════════════════════════════════════════════════════ */
function openPerfumeModal(perfumeId, productId) {
  editingPerfumeId = perfumeId || null;
  selectedImageFile = null;
  document.getElementById('perfumeForm').reset();
  document.getElementById('perfumeFormError').classList.remove('show');
  document.getElementById('imagePreview').style.display = 'none';
  document.getElementById('imageUploadText').textContent = 'Click to upload an image, or drag one here';
  document.getElementById('perfumeForm').dataset.productId = '';

  if (editingPerfumeId) {
    document.getElementById('perfumeModalTitle').textContent = 'Edit Perfume';
    const product = allProducts.find(p => p.product_id === productId);
    if (product) {
      document.getElementById('perfumeForm').dataset.productId = productId;
      const brand = brandsCache.find(b => b.brand_name === product.brand_name);
      if (brand) document.getElementById('fBrand').value = brand.brand_id;
      document.getElementById('fName').value = product.perfume_name || '';
      document.getElementById('fConcentration').value = product.concentration || '';
      document.getElementById('fTopNotes').value = product.top_notes || '';
      document.getElementById('fMiddleNotes').value = product.middle_notes || '';
      document.getElementById('fBaseNotes').value = product.base_notes || '';
      document.getElementById('fProductType').value = product.product_type || '';
      document.getElementById('fVolume').value = product.volume_ml || '';
      document.getElementById('fPrice').value = product.price || '';
      document.getElementById('fStock').value = product.stock_quantity ?? '';
      if (product.image_url) {
        document.getElementById('imagePreview').src = product.image_url;
        document.getElementById('imagePreview').style.display = 'block';
        document.getElementById('imageUploadText').textContent = 'Click to replace image';
      }
      // Gender/season/longevity/description aren't in the lightweight
      // ProductSerializer used for the table — fetch the full perfume
      // record so those fields aren't silently blanked out on edit.
      fetchFullPerfumeDetails(perfumeId);
    }
  } else {
    document.getElementById('perfumeModalTitle').textContent = 'Add New Perfume';
  }

  document.getElementById('perfumeModalOverlay').classList.add('open');
}

async function fetchFullPerfumeDetails(perfumeId) {
  try {
    const res = await fetch(`${API_BASE}/catalog/perfumes/${perfumeId}/`);
    const data = await res.json();
    const perfume = data.perfume || data;
    if (perfume.target_gender) document.getElementById('fGender').value = perfume.target_gender;
    if (perfume.recommended_season) document.getElementById('fSeason').value = perfume.recommended_season;
    if (perfume.longevity_hours) document.getElementById('fLongevity').value = perfume.longevity_hours;
    if (perfume.description) document.getElementById('fDescription').value = perfume.description;
  } catch {
    /* form still works without these prefilled — not fatal */
  }
}

function closePerfumeModal() {
  document.getElementById('perfumeModalOverlay').classList.remove('open');
}

function handleImageSelect(e) {
  const file = e.target.files[0];
  if (!file) return;
  selectedImageFile = file;
  const reader = new FileReader();
  reader.onload = (ev) => {
    document.getElementById('imagePreview').src = ev.target.result;
    document.getElementById('imagePreview').style.display = 'block';
    document.getElementById('imageUploadText').textContent = file.name;
  };
  reader.readAsDataURL(file);
}

async function submitPerfumeForm(e) {
  e.preventDefault();
  const errorEl = document.getElementById('perfumeFormError');
  errorEl.classList.remove('show');

  const brandId = document.getElementById('fBrand').value;
  const name = document.getElementById('fName').value.trim();
  const concentration = document.getElementById('fConcentration').value;
  const gender = document.getElementById('fGender').value;
  const productType = document.getElementById('fProductType').value;
  const volume = document.getElementById('fVolume').value;
  const price = document.getElementById('fPrice').value;

  if (!brandId || !name || !concentration || !gender || !productType || !volume || !price) {
    errorEl.textContent = 'Please fill in every field marked with *.';
    errorEl.classList.add('show');
    return;
  }

  const formData = new FormData();
  formData.append('brand_id', brandId);
  formData.append('perfume_name', name);
  formData.append('concentration', concentration);
  formData.append('target_gender', gender);
  formData.append('longevity_hours', document.getElementById('fLongevity').value || '');
  formData.append('recommended_season', document.getElementById('fSeason').value || '');
  formData.append('top_notes', document.getElementById('fTopNotes').value || '');
  formData.append('middle_notes', document.getElementById('fMiddleNotes').value || '');
  formData.append('base_notes', document.getElementById('fBaseNotes').value || '');
  formData.append('description', document.getElementById('fDescription').value || '');
  formData.append('product_type', productType);
  formData.append('volume_ml', volume);
  formData.append('price', price);
  formData.append('stock_quantity', document.getElementById('fStock').value || '0');
  if (selectedImageFile) formData.append('image', selectedImageFile);

  const submitBtn = document.getElementById('perfumeFormSubmitBtn');
  submitBtn.disabled = true;
  submitBtn.textContent = 'Saving…';

  try {
    let res;
    if (editingPerfumeId) {
      const productId = document.getElementById('perfumeForm').dataset.productId;
      if (productId) formData.append('product_id', productId);
      res = await adminFetch(`${API_BASE}/catalog/admin/perfumes/${editingPerfumeId}/`, {
        method: 'PATCH',
        body: formData,
      });
    } else {
      res = await adminFetch(`${API_BASE}/catalog/admin/perfumes/`, {
        method: 'POST',
        body: formData,
      });
    }

    const data = await res.json();
    if (!res.ok) {
      const firstError = data.errors ? Object.values(data.errors)[0] : (data.error || 'Something went wrong.');
      errorEl.textContent = firstError;
      errorEl.classList.add('show');
      return;
    }

    showToast(editingPerfumeId ? 'Perfume updated.' : 'Perfume added.');
    closePerfumeModal();
    loadProducts();
  } catch {
    errorEl.textContent = 'Network error — check your connection and try again.';
    errorEl.classList.add('show');
  } finally {
    submitBtn.disabled = false;
    submitBtn.textContent = 'Save Perfume';
  }
}

/* ══════════════════════════════════════════════════════════════
   DELETE FLOW
   ══════════════════════════════════════════════════════════════ */
function openDeleteConfirm(productId, name) {
  pendingDeleteProductId = productId;
  document.getElementById('deleteConfirmText').textContent =
    `This will permanently remove "${name}" from the catalog. This can't be undone.`;
  document.getElementById('deleteConfirmOverlay').classList.add('open');
}

function closeDeleteConfirm() {
  document.getElementById('deleteConfirmOverlay').classList.remove('open');
  pendingDeleteProductId = null;
}

async function confirmDelete() {
  if (!pendingDeleteProductId) return;
  const btn = document.getElementById('deleteConfirmActionBtn');
  btn.disabled = true;
  btn.textContent = 'Deleting…';

  try {
    const res = await adminFetch(`${API_BASE}/catalog/admin/products/${pendingDeleteProductId}/`, {
      method: 'DELETE',
    });
    const data = await res.json();
    if (!res.ok) {
      showToast(data.error || 'Could not delete this product.');
      return;
    }
    showToast(data.message || 'Product deleted.');
    closeDeleteConfirm();
    loadProducts();
  } catch {
    showToast('Network error — could not delete this product.');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Delete';
  }
}
